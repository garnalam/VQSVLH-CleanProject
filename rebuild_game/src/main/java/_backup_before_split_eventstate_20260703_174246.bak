            font.drawTagged(g, "#FFFFFFlv" + battlePlayerLevel, 214, 238, 26, 4);
            drawBattleProgressWidget(g, 153, 252, 82, hpPercent(battlePlayerHp, battlePlayerMaxHp), 0x9B9B9B);
